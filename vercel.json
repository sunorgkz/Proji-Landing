{
  "redirects": [
    { "source": "/proji_knowledge", "destination": "/knowledge", "permanent": true },
    { "source": "/sunnet", "destination": "/sunnet/", "permanent": false },
    { "source": "/platform", "destination": "/platform/", "permanent": false },
    { "source": "/crm", "destination": "/crm/", "permanent": false },
    { "source": "/team-ai", "destination": "/team-ai/", "permanent": false },
    { "source": "/digital-team", "destination": "/digital-team/", "permanent": false },
    { "source": "/knowledge-vault", "destination": "/knowledge-vault/", "permanent": false },
    { "source": "/knowledge-twin", "destination": "/knowledge-twin/", "permanent": false },
    { "source": "/insight-hub", "destination": "/insight-hub/", "permanent": false },
    { "source": "/context-flow", "destination": "/context-flow/", "permanent": false },
    { "source": "/flow-forge", "destination": "/flow-forge/", "permanent": false },
    { "source": "/team-ai-collab", "destination": "/team-ai-collab/", "permanent": false },
    { "source": "/pro-ai-council", "destination": "/pro-ai-council/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sunnet/:path*", "destination": "/sunnet/:path*" },
    { "source": "/platform/:path*", "destination": "/platform/:path*" },
    { "source": "/crm/:path*", "destination": "/crm/:path*" },
    { "source": "/team-ai/:path*", "destination": "/team-ai/:path*" },
    { "source": "/digital-team/:path*", "destination": "/digital-team/:path*" },
    { "source": "/knowledge-vault/:path*", "destination": "/knowledge-vault/:path*" },
    { "source": "/knowledge-twin/:path*", "destination": "/knowledge-twin/:path*" },
    { "source": "/insight-hub/:path*", "destination": "/insight-hub/:path*" },
    { "source": "/context-flow/:path*", "destination": "/context-flow/:path*" },
    { "source": "/flow-forge/:path*", "destination": "/flow-forge/:path*" },
    { "source": "/team-ai-collab/:path*", "destination": "/team-ai-collab/:path*" },
    { "source": "/pro-ai-council/:path*", "destination": "/pro-ai-council/:path*" },
    { "source": "/downloads/:path*", "destination": "/downloads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(insight-hub|context-flow|team-ai-collab|pro-ai-council|digital-team|knowledge-vault|knowledge-twin|flow-forge|team-ai|crm)/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
